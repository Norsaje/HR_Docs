# .env.example — все переменные с описанием, без значений.
# Скопируйте в .env и заполните (или выполните `make secrets` — он сгенерирует случайные секреты).
# .env никогда не коммитится. На сервере: chmod 600 .env

# ── Адрес стенда ─────────────────────────────────────────────────────────────
# Публичный адрес без завершающего «/». Варианты: https://<домен>  |  https://<IP>  |  https://localhost
PUBLIC_BASE_URL=
# Адрес сайта для Caddy: домен, IP или localhost (обычно хост из PUBLIC_BASE_URL)
SITE_ADDRESS=
# "internal" — самоподписанный сертификат (IP/localhost); email — Let's Encrypt для домена
CADDY_TLS=internal
APP_TIMEZONE=Europe/Moscow
APP_ENV=prod                      # prod | dev; в prod выключены /docs и подробные ошибки
DOCS_ENABLED=false

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=                # суперпользователь postgres (только init)
HR_OWNER_PASSWORD=                # владелец схемы, только миграции
HR_APP_PASSWORD=                  # роль приложения (api, worker)
KC_DB_PASSWORD=                   # БД keycloak

# ── S3 (SeaweedFS, только внутренняя сеть) ───────────────────────────────────
S3_ENDPOINT=http://seaweedfs:8333
S3_BUCKET=hr-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
FILE_ENCRYPTION=on                # on | off — шифрование файлов AES-256-GCM
FILE_ENC_MASTER_KEY=              # 32 байта в base64: openssl rand -base64 32

# ── Keycloak / OIDC ──────────────────────────────────────────────────────────
KC_BOOTSTRAP_ADMIN_USERNAME=      # администратор master realm (только через SSH-туннель)
KC_BOOTSTRAP_ADMIN_PASSWORD=
KC_ADMIN_URL=http://localhost:8081/kc
KC_BFF_CLIENT_SECRET=             # секрет клиента operator-bff (подставляется в realm при импорте)
KC_ADMIN_CLIENT_SECRET=           # секрет клиента operator-admin (раздел «Сотрудники»)
KC_DEMO_PASSWORD=                 # пароль тестовых операторов, не короче 12 символов
OIDC_ISSUER=                      # ${PUBLIC_BASE_URL}/kc/realms/hr
OIDC_INTERNAL_BASE=http://keycloak:8080/kc/realms/hr
OIDC_CLIENT_ID=operator-bff
GOOGLE_CLIENT_ID=                 # «Войти через Google» для операторов (make kc-google); пусто — кнопки нет
GOOGLE_CLIENT_SECRET=
OIDC_TOKEN_ENDPOINT=              # пусто = из discovery; задать, если discovery отдаёт не тот адрес
OIDC_JWKS_URI=                    # то же
SESSION_ENC_KEY=                  # ключ Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_IDLE_MIN=30
SESSION_ABS_HOURS=10

# ── Модель (Qwen3.8, локальная, в контуре) ───────────────────────────────────
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://llm.ilons.ru/v1   # запасной: http://vllm:8000/v1 (профиль llm-local на A10)
LLM_MODEL=Qwen/Qwen3.8-27B             # должен совпадать с GET {LLM_BASE_URL}/models
LLM_API_KEY=                           # значение ILONS_API_KEY; для vLLM — значение VLLM_API_KEY
LLM_TIMEOUT_S=90
LLM_MAX_CONCURRENCY=6
LLM_IMAGE_MAX_SIDE=1600
LLM_JSON_MODE=json_schema              # json_schema | json_object | prompt
PROMPT_EXTRACT_VERSION=v1
PROMPT_ARBITER_VERSION=v1
ARBITER_ENABLED=true
ARBITER_MAX_FIELDS=6

# ── OCR (olmOCR) ─────────────────────────────────────────────────────────────
OCR_PROVIDER=olmocr_http               # olmocr_http | none
OCR_BASE_URL=https://ocr.ilons.ru
OCR_API_TOKEN=                         # заголовок X-API-Token, если на сервисе включён токен
OCR_TIMEOUT_S=150
OCR_MAX_CONCURRENCY=4
OCR_VOTES_CYRILLIC=true

# ── Локальная модель на A10 (профиль llm-local) ──────────────────────────────
LOCAL_LLM_MODEL=                       # репозиторий весов на Hugging Face (4-битная сборка), см. docs/local-model.md
LOCAL_LLM_SERVED_NAME=local-qwen
VLLM_API_KEY=
HF_TOKEN=                              # только если веса закрытые
LOCAL_LLM_URL=                         # адрес vLLM для make switch-llm TARGET=local; пусто = http://vllm:8000/v1
                                       # (через SSH-туннель с ноутбука на Docker Desktop: http://host.docker.internal:8000/v1)
# Заполняет make switch-llm при первом переключении на local, чтобы вернуться обратно (TARGET=ilons):
ILONS_LLM_BASE_URL=
ILONS_LLM_MODEL=
ILONS_LLM_API_KEY=

# ── Приём файлов ─────────────────────────────────────────────────────────────
MAX_FILE_MB=20
MAX_FILES_PER_REQUEST=20
MAX_FILES_PER_APPLICATION=40
MAX_APPLICATION_MB=200
MAX_PIXELS=40000000
MAX_PDF_PAGES=10
MIN_IMAGE_SIDE=600
NORMALIZE_MAX_SIDE=2400
QUALITY_BLUR_REJECT=25
QUALITY_BLUR_WARN=60
QUALITY_GLARE_REJECT=0.25
QUALITY_GLARE_WARN=0.08
QUALITY_DARK_REJECT=35

# ── Воркер и очередь ─────────────────────────────────────────────────────────
WORKER_CONCURRENCY=8
JOB_MAX_ATTEMPTS=5
JOB_LEASE_S=60
JOB_HEARTBEAT_S=10
REAPER_INTERVAL_S=15

# ── Правила ──────────────────────────────────────────────────────────────────
EXPIRY_WARNING_DAYS=30
NAME_MATCH_THRESHOLD=0.92

# ── Соискатель, согласие, почта ──────────────────────────────────────────────
APPLICANT_TOKEN_TTL_DAYS=30
CONSENT_VERSION=v1
POLICY_VERSION=v1
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=                             # например: noreply@<домен агентства>
NOTIFY_MIN_INTERVAL_MIN=10

# ── Хранение данных (P2) ─────────────────────────────────────────────────────
RETENTION_DAYS=90
